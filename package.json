{
  "name": "service-hub",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n API,WEB \"npm:api\" \"npm:web\"",
    "web": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "api": "node server/index.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "node --test server/test/*.test.cjs",
    "test:e2e": "playwright test",
    "seed:reset": "node server/reset.cjs --confirm",
    "verify": "npm run build && npm test",
    "files:audit": "node server/files-audit.cjs",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"shared/*.ts\" \"server/**/*.cjs\" \"scripts/*.cjs\" \"tests/**/*.ts\" \"*.json\" \"*.ts\" \"*.md\" \"docs/**/*.md\""
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/router": "20.3.33",
    "bootstrap": "5.3.8",
    "json-server": "0.17.4",
    "multer": "2.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.33",
    "@angular/cli": "20.3.33",
    "@angular/compiler-cli": "20.3.33",
    "@playwright/test": "1.56.1",
    "concurrently": "9.2.5",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@angular/build": {
      "piscina": "5.3.2",
      "vitest": "$vitest"
    },
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.31.0"
    }
  }
}
